  <!-- Commands & Tools wheel behavior -->
  <wheel>
    <!-- Change Brush Size -->
    <wheel action="ChangeBrushSize" command="ChangeBrush">
      <param name="change" value="increment-size" delta="1" />
      <param name="change" value="decrement-size" delta="-1" />
    </wheel>

    <!-- Change Brush Angle -->
    <wheel action="ChangeBrushAngle" command="ChangeBrush">
      <param name="change" value="increment-angle" delta="1" />
      <param name="change" value="decrement-angle" delta="-1" />
    </wheel>

    <!-- Change Frame -->
    <wheel action="ChangeFrame" command="GotoFrame">
      <param name="frame" value="next" delta="1" />
      <param name="frame" value="previous" delta="-1" />
    </wheel>

    <!-- Change Ink Opacity -->
    <wheel action="ChangeInkOpacity" command="SetInkType">
      <param name="opacity" value="increment" delta="1" />
      <param name="opacity" value="decrement" delta="-1" />
    </wheel>

    <!-- Change Layer -->
    <wheel action="ChangeLayer" command="GotoLayer">
      <param name="layer" value="above" delta="1" />
      <param name="layer" value="below" delta="-1" />
    </wheel>

    <!-- Change Palette Slot -->
    <wheel action="ChangePaletteSlot" command="ChangeColor">
      <param name="target" value="fg" />
      <param name="change" value="increment-index" delta="1" />
      <param name="change" value="decrement-index" delta="-1" />
    </wheel>
    <wheel action="ChangePaletteSlot" command="ChangeColor">
      <param name="target" value="bg" />
      <param name="change" value="increment-index" delta="1" />
      <param name="change" value="decrement-index" delta="-1" />
    </wheel>
    <wheel action="ChangePaletteSlot" command="SelectPaletteColors">
      <param name="change" value="increment-index" delta="1" />
      <param name="change" value="decrement-index" delta="-1" />
    </wheel>

    <!-- Change Layer Opacity -->
    <wheel action="ChangeLayerOpacity" command="LayerOpacity">
      <param name="opacity" value="increment" delta="1" />
      <param name="opacity" value="decrement" delta="-1" />
    </wheel>

    <!-- Change Cel Opacity -->
    <wheel action="ChangeCelOpacity" command="CelOpacity">
      <param name="opacity" value="increment" delta="1" />
      <param name="opacity" value="decrement" delta="-1" />
    </wheel>

    <!-- Change Tool -->
    <wheel action="ChangeTool" command="ChangeBrush">
      <param name="change" value="next-tool" delta="1" />
      <param name="change" value="previous-tool" delta="-1" />
    </wheel>
  </wheel>

